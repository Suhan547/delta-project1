<% layout("/layouts/boilerplate") %>

<div id="filters" class="d-flex flex-column flex-md-row align-items-md-center justify-content-between my-3 gap-3">
  <!-- Horizontally Scrollable Category Icons -->
  <div class="filter-container d-flex align-items-center">
    <a href="/listings?category=Trending" class="filter text-center text-decoration-none">
      <div><i class="fa-solid fa-fire"></i></div>
      <p>Trending</p>
    </a>
    <a href="/listings?category=Rooms" class="filter text-center text-decoration-none">
      <div><i class="fa-solid fa-bed"></i></div>
      <p>Rooms</p>
    </a>
    <a href="/listings?category=Iconic Cities" class="filter text-center text-decoration-none">
      <div><i class="fa-solid fa-mountain-city"></i></div>
      <p>Iconic Cities</p>
    </a>
    <a href="/listings?category=Mountains" class="filter text-center text-decoration-none">
      <div><i class="fa-solid fa-mountain"></i></div>
      <p>Mountains</p>
    </a>
    <a href="/listings?category=Castles" class="filter text-center text-decoration-none">
      <div><i class="fa-solid fa-fort-awesome"></i></div>
      <p>Castles</p>
    </a>
    <a href="/listings?category=Arctic" class="filter text-center text-decoration-none">
      <div><i class="fa-regular fa-snowflake"></i></div>
      <p>Arctic</p>
    </a>
    <a href="/listings?category=Camping" class="filter text-center text-decoration-none">
      <div><i class="fa-solid fa-campground"></i></div>
      <p>Camping</p>
    </a>
    <a href="/listings?category=Farms" class="filter text-center text-decoration-none">
      <div><i class="fa-solid fa-cow"></i></div>
      <p>Farms</p>
    </a>
    <a href="/listings?category=Domes" class="filter text-center text-decoration-none">
      <div><i class="fa-solid fa-igloo"></i></div>
      <p>Domes</p>
    </a>
    <a href="/listings?category=Boats" class="filter text-center text-decoration-none">
      <div><i class="fa-solid fa-ship"></i></div>
      <p>Boats</p>
    </a>
  </div>

  <!-- Tax Toggle Box -->
  <div class="tax-toggle border rounded-3 p-2 d-flex align-items-center">
    <div class="form-check form-switch mb-0">
      <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckDefault">
      <label class="form-check-label small ms-2" for="flexSwitchCheckDefault">Display total after taxes</label>
    </div>
  </div>
</div>

<!-- Responsive Listings Grid (1 col on mobile, 2 on tablet, 3 on desktop) -->
<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4 mt-1">
  <% for(let listing of allListings) { %>
    <div class="col">
      <a href="/listings/<%= listing._id %>" class="listing-link text-decoration-none text-dark">
        <div class="card h-100 listing-card border-0 shadow-sm">
          <img 
            src="<%= listing.image.url %>" 
            class="card-img-top" 
            alt="listing_image" 
            style="height: 18rem; object-fit: cover;"
          />
          <div class="card-body px-1">
            <p class="card-text mb-0">
              <b><%= listing.title %></b> <br />
              &#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %> / night
              <i class="tax-info text-muted small" style="display: none;"> &nbsp;+18% GST</i>
            </p>
          </div>
        </div>
      </a>
    </div>
  <% } %>
</div>

<script>
  const taxSwitch = document.getElementById("flexSwitchCheckDefault");
  taxSwitch.addEventListener("click", () => {
    const taxInfoElements = document.getElementsByClassName("tax-info");
    for (let info of taxInfoElements) {
      info.style.display = (info.style.display === "none" || info.style.display === "") ? "inline" : "none";
    }
  });
</script>