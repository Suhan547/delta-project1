<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
  <!-- Title -->
  <div class="col-12 col-md-8 offset-md-2">
    <h3 class="mb-3"><%= listing.title %></h3>
  </div>

  <!-- Listing Card -->
  <div class="col-12 col-md-8 offset-md-2">
    <div class="card show-card listing-card border-0">
      <img 
        src="<%= listing.image.url %>" 
        class="card-img-top show-img rounded-4" 
        alt="listing_image"
        style="max-height: 22rem; object-fit: cover;"
      />

      <div class="card-body px-0">
        <p class="card-text text-muted mb-1">Owned by <i><%= listing.owner.username %></i></p>
        <p class="card-text"><%= listing.description %></p>
        <p class="card-text fw-bold fs-5">
          &#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %> / night
        </p>
        <p class="card-text mb-1"><i class="fa-solid fa-location-dot me-2 text-danger"></i><%= listing.location %>, <%= listing.country %></p>
      </div>
    </div>
  </div>

  <!-- Edit / Delete Actions -->
  <% if(currUser && listing.owner._id.equals(currUser._id)) { %>
    <div class="col-12 col-md-8 offset-md-2 d-flex gap-3 mb-4">
      <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark px-4 edit-btn">Edit</a> 
      <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
        <button class="btn btn-danger px-4">Delete</button>
      </form>
    </div>
  <% } %>

  <!-- Map Section -->
  <div class="col-12 col-md-8 offset-md-2 mb-4">
    <hr />
    <h4 class="mb-3">Where you'll be</h4>
    <div id="map" class="rounded-4" style="width: 100%; height: 320px;"></div>
  </div>

  <!-- Reviews Section -->
  <div class="col-12 col-md-8 offset-md-2 mb-4">
    <% if(currUser) { %>
      <hr />
      <h4>Leave a Review</h4>

      <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
        <div class="mb-3 mt-3">
          <label for="rating" class="form-label">Rating</label>
          <fieldset class="starability-slot">
            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
            <label for="first-rate1" title="Terrible">1 star</label>
            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
            <label for="first-rate2" title="Not good">2 stars</label>
            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
            <label for="first-rate3" title="Average">3 stars</label>
            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
            <label for="first-rate4" title="Very good">4 stars</label>
            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
            <label for="first-rate5" title="Amazing">5 stars</label>
          </fieldset>
        </div>

        <div class="mb-3">
          <label for="comment" class="form-label">Comments</label>
          <textarea 
            name="review[comment]" 
            id="comment" 
            rows="4" 
            class="form-control" 
            required
          ></textarea>
          <div class="invalid-feedback">Please add some comments for review</div>
        </div>
        <button class="btn btn-outline-dark">Submit</button>
      </form>
    <% } %>

    <% if(listing.reviews.length > 0) { %>
      <hr />
      <p class="fs-5"><b>All Reviews (<%= listing.reviews.length %>)</b></p>
      
      <!-- Responsive Review Cards: 1 col on mobile, 2 col on tablet/desktop -->
      <div class="row row-cols-1 row-cols-md-2 g-3">
        <% for(review of listing.reviews) { %>
          <div class="col">
            <div class="card h-100 p-3 shadow-sm border-0 bg-light rounded-3">
              <div class="card-body p-0">
                <h6 class="card-title fw-bold">@<%= review.author.username %></h6>
                <p class="starability-result mb-2" data-rating="<%= review.rating %>"></p>
                <p class="card-text text-secondary mb-3"><%= review.comment %></p>
              </div>
              <% if(currUser && review.author._id.equals(currUser._id)) { %>
                <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                  <button class="btn btn-sm btn-outline-danger">Delete</button>
                </form>
              <% } %>
            </div>
          </div>
        <% } %>
      </div>
    <% } %>
  </div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
  const listing = <%- JSON.stringify(listing) %>;
</script>
<script src="/js/map.js"></script>